# ============================================================
# CTI Platform — Environment Configuration
# Copy this to .env and fill in real values
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-random-secret-256-bit
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Database ---
DATABASE_URL=postgresql://cti_user:cti_pass@localhost:5432/cti_db
# For SQLite (dev only):
# DATABASE_URL=sqlite:///./data/cti.db

# --- API Keys (Threat Feeds) ---
# NVD API (free, but rate-limited without key)
# Get at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# AlienVault OTX (free)
# Get at: https://otx.alienvault.com/api
OTX_API_KEY=

# Shodan (optional, for enrichment)
SHODAN_API_KEY=

# VirusTotal (optional, for IOC enrichment)
VT_API_KEY=

# --- TAXII (STIX feeds) ---
# Example: MITRE ATT&CK TAXII server (no key needed)
TAXII_SERVER_URL=https://cti-taxii.mitre.org/taxii/
TAXII_USERNAME=
TAXII_PASSWORD=

# --- Scheduler ---
COLLECTION_INTERVAL_MINUTES=60   # How often to fetch new data
ALERT_CHECK_INTERVAL_MINUTES=5

# --- Alert System ---
# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=cti-alerts@yourdomain.com
ALERT_TO_EMAILS=soc@yourdomain.com,admin@yourdomain.com

# Slack webhook alerts
SLACK_WEBHOOK_URL=

# Alert thresholds
CRITICAL_CVSS_THRESHOLD=9.0
HIGH_CVSS_THRESHOLD=7.0
ALERT_ON_EXPLOIT_AVAILABLE=true

# --- Dashboard Auth ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_EXPIRY_HOURS=8

# --- Integrations ---
SENTINELSCAN_API_URL=http://localhost:8001
SENTINELSCAN_API_KEY=
MALWARE_DETECTION_API_URL=http://localhost:8002
MALWARE_DETECTION_API_KEY=
